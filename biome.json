{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "json": {
    "formatter": { "indentStyle": "space", "indentWidth": 2 }
  },
  "files": {
    "ignore": ["node_modules", "dist", "*.json"]
  }
}
