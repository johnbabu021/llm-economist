{
  "name": "llm-economist",
  "version": "0.1.0",
  "description": "MCP server that helps find the best LLM model for any use case with provider/pricing comparison",
  "type": "module",
  "bin": {
    "llm-economist": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "validate-data": "tsx scripts/validate-data.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "llm",
    "ai",
    "pricing",
    "model-comparison",
    "openai",
    "anthropic",
    "openrouter",
    "bedrock",
    "fireworks",
    "together-ai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.15.3",
    "tsup": "8.4.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
